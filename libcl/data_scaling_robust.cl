@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:FP32] @0x0000
    Q[16×16:FP32] @0x0200
    Y[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    Q2: T[16×16:FP32], IQR_INV: T[16×16:FP32]

    X ↦ Y :
        D := X - Q2
        S := D * IQR_INV
        Z := N(S)
        Y := σ(Z)
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    @0x0400 ← #R3
}

!Δ { ∥Y∥ < 1e5 }

