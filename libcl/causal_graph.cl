@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:FP32] @0x0000
    S[16×16:FP32] @0x0200
    Y[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    A: T[16×16:FP32], W: T[16×16:FP32]

    X ↦ Y :
        D := (X * S) + W
        M := D <~> A
        Z := N(M)
        Y := σ(Z)
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    @0x0400 ← #R3
}

!Δ { ∥Y∥ < 1e5 }
