@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:FP32] @0x0000
    W[16×16:FP32] @0x0200
    Y[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    W: T[16×16:FP32], M: T[16×16:FP32], S: T[16×16:FP32]

    X ↦ Y :
        Z := X - M
        C := Z * S
        P := C <~> W
        E := P * 0.9 + C * 0.1
        Y := σ(E)
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    @0x0400 ← #R3
}

!Δ { ∥Y∥ < 1e4 }
