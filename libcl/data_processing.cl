@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:FP32] @0x0000
    W[16×16:FP32] @0x0200
    Y[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    W: T[16×16:FP32]

    X ↦ Y :
        Z := X -> _IMP(0.0) -> _RSC -> _MAS -> _BCX(0.5)
        P := Z <~> W
        Y := P -> _EMA(0.9) -> _Z0 -> _SI
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    @0x0400 ← #R3
}

!Δ { ∥Y∥ < 1e4 }
