@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:FP32] @0x0000
    N[16×16:FP32] @0x0200
    Y[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    N: T[16×16:FP32]

    X ↦ Y :
        R := X + N
        S := R * 0.5
        P := S <~> N
        Y := σ(P)
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 + #R2
    #R4 := #R3 * #R2
    @0x0400 ← #R4
}

!Δ { ∥Y∥ < 1e5 }
