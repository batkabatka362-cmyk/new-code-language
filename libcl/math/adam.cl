// ════════════════════════════════════════════════════════════════════════════
// [Δθ] :: (w, m, v) ↦ w - η * (m / (√(v) + ε) + λ * w)
// ════════════════════════════════════════════════════════════════════════════

β1 = 0.9
β2 = 0.999
ε = 1e-8
η = 0.001
λ = 0.01

μ1(m, g) = β1 * m + (1.0 - β1) * g
μ2(v, g) = β2 * v + (1.0 - β2) * (g^2)
Δθ(w, m, v) = w - η * (m / (√(v) + ε) + λ * w)
