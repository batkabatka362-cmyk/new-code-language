// ════════════════════════════════════════════════════════════════════════════
// [B] :: X[B, D] × W[M, D] × γ ↦ ((X / √(μ(X * X) + ε)) @ τ(W)^T) * γ
// ════════════════════════════════════════════════════════════════════════════

ε = 1e-5

B(X[B, D], W[M, D], γ) = ((X / √(μ(X * X) + ε)) @ τ(W)^T) * γ
B0(X[B, D], W[M, D], γ) = (X @ τ(W)^T) * γ
