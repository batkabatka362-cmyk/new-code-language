// ════════════════════════════════════════════════════════════════════════════
// [A] :: X[T, D] × Wq[D, D] × Wk[D, D] × Wv[D, D] × Wo[D, D] × s ↦ Ψ(X @ Wq, X @ Wk, X @ Wv, s) @ Wo
// ════════════════════════════════════════════════════════════════════════════

A(X[T, D], Wq[D, D], Wk[D, D], Wv[D, D], Wo[D, D], s) =
    Ψ(X @ Wq, X @ Wk, X @ Wv, s) @ Wo

A_Φ(X[T, D], Wq[D, D], Wk[D, D], Wv[D, D], Wo[D, D], s) =
    Ψ(Φ(X @ Wq, 10000.0), Φ(X @ Wk, 10000.0), X @ Wv, s) @ Wo
