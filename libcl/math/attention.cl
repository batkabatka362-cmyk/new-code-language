// ════════════════════════════════════════════════════════════════════════════
// [A] :: (Q, K, V) ↦ ρ((Q @ K) * s) @ V
// ════════════════════════════════════════════════════════════════════════════

s = 0.125
ε = 1e-6

Ω(Q, K) = (Q @ K) * s
A(Q, K, V) = ρ((Q @ K) * s) @ V
Π(x, Wq, Wk, Wv, Wo) = Wo @ A(Wq @ x, Wk @ x, Wv @ x)
