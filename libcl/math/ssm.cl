// ════════════════════════════════════════════════════════════════════════════
// [F] :: (h, x, A, B, C, D) ↦ [A * h + B * x, C * (A * h + B * x) + D * x]
// ════════════════════════════════════════════════════════════════════════════

H(h, x, A, B) = A * h + B * x
Y(h, x, C, D) = C * h + D * x
F(h, x, A, B, C, D) = [A * h + B * x, C * (A * h + B * x) + D * x]
