// ════════════════════════════════════════════════════════════════════════════
// [N] :: X[B, D] × γ[D] ↦ (X / √(μ(X * X) + ε)) * γ
// ════════════════════════════════════════════════════════════════════════════

ε = 1e-5

N(X[B, D], γ[D]) = (X / √(μ(X * X) + ε)) * γ
N_ε(X[B, D], γ[D], e) = (X / √(μ(X * X) + e)) * γ
