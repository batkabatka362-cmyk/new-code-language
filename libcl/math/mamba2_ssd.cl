// ════════════════════════════════════════════════════════════════════════════
// [M] :: X[T, D] × A[D] × B[D, N] × C[D, N] × Δ[D] ↦ Ξ(X, A, B, C, Δ)
// ════════════════════════════════════════════════════════════════════════════

M(X[T, D], A[D], B[D, N], C[D, N], Δ[D]) = Ξ(X, A, B, C, Δ)
M2(X[T, D], A[D]) = Ξ(X, A)
