@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:BF16] @0x0000
    S[16×16:BF16] @0x0200
    Y[16×16:BF16] @0x0400
}

§[16×16:BF16] {
    H: SS[64×256], W: T[16×16:BF16]

    X ↦ Y :
        M := ssd(X >>= S, H)
        Z := N(X)
        Y := σ((Z <~> M) ~*~ M)
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    @0x0400 ← #R3
}

!Δ { ∥Y∥ < 1e5 }
