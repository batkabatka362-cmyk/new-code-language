@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    A[16×16:FP32] @0x0000
    B[16×16:FP32] @0x0200
    Y[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    λ: T[16×16:FP32]

    A ↦ Y :
        Δ := B - A
        I := Δ * λ
        X := A + I
        Y := σ(X)
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R2 - #R1
    #R4 := #R3 + #R1
    @0x0400 ← #R4
}

!Δ { ∥Y∥ < 1e5, variance_ratio > 0.8 }
