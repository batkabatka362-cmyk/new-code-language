@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    G[16×16:FP32] @0x0000
    W[16×16:FP32] @0x0200
    O[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    W: T[16×16:FP32]

    G ↦ O :
        M := G * 0.9
        V := G * G
        U := M * 0.01
        O := W - U
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R1
    #R4 := #R2 - #R1
    @0x0400 ← #R4
}

!Δ { ∥O∥ < 1e5 }
