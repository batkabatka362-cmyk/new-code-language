@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    A[16×16:FP32] @0x0000
    B[16×16:FP32] @0x0200
    M[16×16:FP32] @0x0400
    Y[16×16:FP32] @0x0600
}

§[16×16:FP32] {
    B: T[16×16:FP32], M: T[16×16:FP32]

    A ↦ Y :
        D := A - B
        P := D * M
        V := σ(P)
        Y := V * 1.0
}

⟳ (64) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    #R4 ← @0x0400
    #R5 := #R3 * #R4
    @0x0600 ← #R5
}

!Δ { ∥Y∥ < 1e5 }
