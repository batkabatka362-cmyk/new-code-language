@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    P[16×16:FP32] @0x0000
    Q[16×16:FP32] @0x0200
    W[16×16:FP32] @0x0400
    Y[16×16:FP32] @0x0600
}

§[16×16:FP32] {
    Q: T[16×16:FP32], W: T[16×16:FP32]

    P ↦ Y :
        D := P <~> Q
        S := D * 0.01
        U := W + S
        Y := σ(U)
}

⟳ (64) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    #R4 ← @0x0400
    #R5 := #R3 * #R4
    @0x0600 ← #R5
}

!Δ { ∥Y∥ < 1e5 }
