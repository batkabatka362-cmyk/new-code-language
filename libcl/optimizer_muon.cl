@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    G[16×16:FP32] @0x0000
    W[16×16:FP32] @0x0200
    O[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    W: T[16×16:FP32]

    G ↦ O :
        X := N(G)
        A := X * X
        B := A * 2.0315 - 4.7750
        C := A * B + 3.4445
        U := X * C
        O := W - U * 0.02
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    @0x0400 ← #R3
}

!Δ { ∥O∥ < 1e5 }

