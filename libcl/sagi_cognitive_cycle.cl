@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:FP32] @0x0000
    T[16×16:FP32] @0x0200
    C[16×16:FP32] @0x0400
    Y[16×16:FP32] @0x0600
}

§[16×16:FP32] {
    T: T[16×16:FP32], C: T[16×16:FP32]

    X ↦ Y :
        F := X * T
        P := F <~> C
        U := F + P * 0.2
        Y := σ(U)
}

⟳ (64) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    #R4 ← @0x0400
    #R5 := #R3 * #R4
    @0x0600 ← #R5
}

!Δ { ∥Y∥ < 1e5 }
