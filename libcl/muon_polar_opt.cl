@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    G[16×16:FP32] @0x0000
    W[16×16:FP32] @0x0200
    U[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    A: T[16×16:FP32]

    G ↦ U :
        M := G ⊗ G
        N := σ(∥M∥)
        U := N ⊗ A
}

⟳ (64) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R1
    #R4 := #R3 + #R2
    @0x0400 ← #R4
}

!Δ { ∥U∥ < 1e5 }
