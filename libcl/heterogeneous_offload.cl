@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:NVFP4] @0x0000
    S[16×16:NVFP4] @0x0200
    Y[16×16:NVFP4] @0x0400
}

§[16×16:NVFP4] {
    P: T[16×16:NVFP4], B: T[16×16:NVFP4]

    X ↦ Y :
        D := X <~> S
        Z := N(D)
        E := Z * B
        Y := σ(E)
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    @0x0400 ← #R3
}

!Δ { ∥Y∥ < 1e5 }
