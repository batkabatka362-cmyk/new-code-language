@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    Q[16×16:FP32] @0x0000
    K[16×16:FP32] @0x0200
    M[16×16:FP32] @0x0400
    Y[16×16:FP32] @0x0600
}

§[16×16:FP32] {
    K: T[16×16:FP32], M: T[16×16:FP32]

    Q ↦ Y :
        S := Q <~> K
        W := S * M
        A := σ(W)
        Y := A * 0.25
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    #R4 ← @0x0400
    #R5 := #R3 * #R4
    @0x0600 ← #R5
}

!Δ { ∥Y∥ < 1e5 }
