@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    O[16×16:FP32] @0x0000
    S[16×16:FP32] @0x0200
    A[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    S: T[16×16:FP32]

    O ↦ A :
        E := O - S
        P := E <~> S
        B := P + S * 0.1
        A := σ(B)
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 - #R2
    #R4 := #R3 * #R2
    @0x0400 ← #R4
}

!Δ { ∥A∥ < 1e5 }
