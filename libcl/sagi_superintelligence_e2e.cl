@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:FP32] @0x0000
    H[16×16:FP32] @0x0200
    U[16×16:FP32] @0x0400
    Y[16×16:FP32] @0x0600
}

§[16×16:FP32] {
    H: T[16×16:FP32], U: T[16×16:FP32]

    X ↦ Y :
        P := X <~> H
        M := P * U
        A := σ(M)
        Y := A * 0.8
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    #R4 ← @0x0400
    #R5 := #R3 * #R4
    @0x0600 ← #R5
}

!Δ { ∥Y∥ < 1e5 }
