@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    Q[16×16:FP32] @0x0000
    K[16×16:FP32] @0x0200
    Y[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    α: T[16×16:FP32], τ: T[16×16:FP32]

    Q ↦ Y :
        Z := Q ⊗ K
        S := Z * α
        Y := σ(∥S∥)
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    #R4 := #R3 + #R2
    @0x0400 ← #R4
}

!Δ { ∥Y∥ < 1e5, top1_accuracy > 0.98 }
