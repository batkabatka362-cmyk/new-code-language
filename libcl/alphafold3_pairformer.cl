@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    P[16×16:FP32] @0x0000
    M[16×16:FP32] @0x0200
    U[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    W: T[16×16:FP32]

    P ↦ U :
        T := P <~> M
        I := T * W
        N := σ(∥I∥)
        U := σ(N)
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    #R4 := #R3 + #R1
    @0x0400 ← #R4
}

!Δ { ∥U∥ < 1e4 }
