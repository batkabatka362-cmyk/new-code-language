@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:FP32] @0x0000
    O[16×16:FP32] @0x0200
    L[16×16:FP32] @0x0400
    Y[16×16:FP32] @0x0600
}

§[16×16:FP32] {
    O: T[16×16:FP32], L: T[16×16:FP32]

    X ↦ Y :
        M := X * O
        P := M <~> L
        S := σ(P)
        Y := S * 0.75
}

⟳ (64) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    #R4 ← @0x0400
    #R5 := #R3 * #R4
    @0x0600 ← #R5
}

!Δ { ∥Y∥ < 1e5 }
