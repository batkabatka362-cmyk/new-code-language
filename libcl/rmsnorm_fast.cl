@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:FP32] @0x0000
    G[16×16:FP32] @0x0200
    Y[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    G: T[16×16:FP32]

    X ↦ Y :
        V := X * X
        R := ∥V∥
        S := X * G
        Y := S * 0.25
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R1
    #R4 := #R1 * #R2
    @0x0400 ← #R4
}

!Δ { ∥Y∥ < 1e5 }
