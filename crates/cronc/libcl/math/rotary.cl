// ════════════════════════════════════════════════════════════════════════════
// [R] :: (x1, x2, c, s) ↦ [x1 * c - x2 * s, x1 * s + x2 * c]
// ════════════════════════════════════════════════════════════════════════════

R(x1, x2, c, s) = [x1 * c - x2 * s, x1 * s + x2 * c]
R_(x1, x2, c, s) = [x1 * c + x2 * s, -x1 * s + x2 * c]
