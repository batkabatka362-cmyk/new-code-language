// ════════════════════════════════════════════════════════════════════════════
// [S] :: X[B, D] × W1[D, H] × W2[D, H] × W3[H, D] ↦ ((X @ W1 * σ(X @ W1)) * (X @ W2)) @ W3
// ════════════════════════════════════════════════════════════════════════════

S(X[B, D], W1[D, H], W2[D, H], W3[H, D]) = ((X @ W1 * σ(X @ W1)) * (X @ W2)) @ W3
