{
  "name": "cron-lang",
  "displayName": "CRON Cognitive Language Support",
  "description": "Language support, syntax highlighting, snippets, and LSP 3.17 engine for CRON (.cr) & CRON Low-Level (.cl) 256-Core 4D-Torus Processor",
  "version": "1.2.0",
  "publisher": "cron-ai",
  "engines": {
    "vscode": "^1.80.0"
  },
  "scripts": {
    "vscode:prepublish": "echo ready",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:cron",
    "onLanguage:cron-cl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cron",
        "aliases": ["CRON", "cron"],
        "extensions": [".cr"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cron-cl",
        "aliases": ["CRON Low-Level Machine Code", "cron-cl"],
        "extensions": [".cl", ".clm"],
        "configuration": "./language-configuration-cl.json"
      }
    ],
    "grammars": [
      {
        "language": "cron",
        "scopeName": "source.cron",
        "path": "./syntaxes/cron.tmLanguage.json"
      },
      {
        "language": "cron-cl",
        "scopeName": "source.cron-cl",
        "path": "./syntaxes/cron-cl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cron",
        "path": "./snippets/cron.json"
      },
      {
        "language": "cron-cl",
        "path": "./snippets/cron-cl.json"
      }
    ],
    "commands": [
      {
        "command": "cron.quickMenu",
        "title": "CRON: Open Quick Command Palette"
      },
      {
        "command": "cron.check",
        "title": "CRON: Check Linear Types & Syntax"
      },
      {
        "command": "cron.buildC23",
        "title": "CRON: Compile .cr to C23"
      },
      {
        "command": "cron.runNative",
        "title": "CRON: Execute Native Host Binary"
      },
      {
        "command": "cron.verifySafety",
        "title": "CRON: Verify Landauer Thermodynamics & Deadlock Safety"
      },
      {
        "command": "cron.healCl",
        "title": "CRON .cl: Auto-Heal Microcode with Autonomous Vibe Loop"
      },
      {
        "command": "cron.optCl",
        "title": "CRON .cl: Super-Optimize VLIW Microcode (DAG Level 2)"
      },
      {
        "command": "cron.runJitCl",
        "title": "CRON .cl: Execute Machine Code on JIT Simulator"
      },
      {
        "command": "cron.clPerf",
        "title": "CRON .cl: Benchmark Silicon Roofline & TOPS/W"
      },
      {
        "command": "cron.clVcd",
        "title": "CRON .cl: Generate Digital Logic VCD Waveform"
      },
      {
        "command": "cron.openSwarmTui",
        "title": "CRON: Launch 256-Core Swarm Silicon TUI Monitor"
      },
      {
        "command": "cron.startDebugging",
        "title": "CRON: Start Hardware Debugger Session (DAP)"
      },
      {
        "command": "cron.openMeshVisualizer",
        "title": "CRON: Open 4D-Torus & Wafer-65536 Live Silicon Visualizer"
      }
    ],
    "breakpoints": [
      { "language": "cron" },
      { "language": "cron-cl" }
    ],
    "debuggers": [
      {
        "type": "cron",
        "label": "CRON Hardware Debugger",
        "languages": ["cron", "cron-cl"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute or workspace-relative path to .cr or .cl file to debug",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop at entry (Cycle #1)",
                "default": true
              },
              "coreId": {
                "type": "number",
                "description": "Core index in 256-core 4D-Torus to inspect (0-255)",
                "default": 0
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "cron",
            "name": "Debug CRON Hardware Program",
            "request": "launch",
            "program": "${file}",
            "stopOnEntry": true,
            "coreId": 0
          }
        ]
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "cron.check",
          "when": "editorLangId == cron",
          "group": "cron_group@1"
        },
        {
          "command": "cron.runNative",
          "when": "editorLangId == cron",
          "group": "cron_group@2"
        },
        {
          "command": "cron.buildC23",
          "when": "editorLangId == cron",
          "group": "cron_group@3"
        },
        {
          "command": "cron.verifySafety",
          "when": "editorLangId == cron || editorLangId == cron-cl",
          "group": "cron_group@4"
        },
        {
          "command": "cron.runJitCl",
          "when": "editorLangId == cron-cl",
          "group": "cron_group@1"
        },
        {
          "command": "cron.healCl",
          "when": "editorLangId == cron-cl",
          "group": "cron_group@2"
        },
        {
          "command": "cron.optCl",
          "when": "editorLangId == cron-cl",
          "group": "cron_group@3"
        },
        {
          "command": "cron.clPerf",
          "when": "editorLangId == cron-cl",
          "group": "cron_group@4"
        }
      ]
    },
    "configuration": {
      "title": "CRON Language Support",
      "properties": {
        "cron.lsp.serverPath": {
          "type": "string",
          "default": "cron",
          "description": "Path to the 'cron' executable (runs 'cron lsp')"
        },
        "cron.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace communication between VS Code and the CRON Language Server"
        }
      }
    }
  }
}
