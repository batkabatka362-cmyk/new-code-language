@⌖ [4×4×4×4] : ⮑ (x+1, y, z, w)

@io {
    X[16×16:FP32] @0x0000
    W[16×16:FP32] @0x0200
    Y[16×16:FP32] @0x0400
}

§[16×16:FP32] {
    K: T[16×16:FP32], V: T[16×16:FP32], Q: T[16×16:FP32]

    X ↦ Y :
        N := |/|(X)
        A := N <~> K
        S := _SI(A)
        H := S ~*~ V
        Y := X \+\ H
}

⟳ (256) {
    #R1 ← @0x0000
    #R2 ← @0x0200
    #R3 := #R1 * #R2
    @0x0400 ← #R3
}

!Δ { ∥Y∥ < 1e5 }

B0000: '==01#000> '==02#010> _RM03$010> _MD04*030>
B0001: _SI05$040> _ML06*050> _PO07+010> !HL00#000>
