// ────────────────────────────────────────────────────────────────────────────
// S : x + S(N(x, γ, 1e-5), W_g, W_u, W_d)
// ────────────────────────────────────────────────────────────────────────────

N(x, γ, ε) = (x / √(μ(x^2) + ε)) * γ
G(x, W_g)  = (x @ W_g) * σ(x @ W_g)
U(x, W_u)  = x @ W_u
S(x, W_g, W_u, W_d) = (G(x, W_g) * U(x, W_u)) @ W_d
F(x, γ, W_g, W_u, W_d) = x + S(N(x, γ, 1e-5), W_g, W_u, W_d)
