// ────────────────────────────────────────────────────────────────────────────
// Ξ : Y(H(h, a, x @ W_b, x), x @ W_c, d, x)
// ────────────────────────────────────────────────────────────────────────────

H(h, a, b, x) = (a * h) + (b * x)
Y(h, c, d, x) = (c * h) + (d * x)
Ξ(x, h, a, W_b, W_c, d) = Y(H(h, a, x @ W_b, x), x @ W_c, d, x)
