// ────────────────────────────────────────────────────────────────────────────
// Ψ_m ∘ S ∘ Ξ ∘ K ∘ Θ
// ────────────────────────────────────────────────────────────────────────────

N(x, γ, ε) = (x / √(μ(x^2) + ε)) * γ

c(x, W_d) = x @ W_d
q(c, W_q) = c @ W_q
k(c, W_k) = c @ W_k
v(c, W_v) = c @ W_v
Ψ(q, k, v) = ρ((q @ k^T) * 0.125) @ v
Ψ_m(x, W_d, W_q, W_k, W_v) = Ψ(q(c(x, W_d), W_q), k(c(x, W_d), W_k), v(c(x, W_d), W_v))

G(x, W_g) = (x @ W_g) * σ(x @ W_g)
U(x, W_u) = x @ W_u
S(x, W_g, W_u, W_d) = (G(x, W_g) * U(x, W_u)) @ W_d

K(x, W_k) = T_B(x, 2) @ W_k
Ξ(x, h, a, W_b, W_c, d) = ((x @ W_c) * ((a * h) + ((x @ W_b) * x))) + (d * x)
Θ(M, α, k, v, q) = ((α * M) + (k ⊗ v)) @ q

x = [[1.0, 2.0], [2.0, 1.0]]
y = [[0.5, 1.5], [1.5, 0.5]]
γ = [1.0, 1.0]

W_d = [[1.0, 0.0], [0.0, 1.0]]
W_q = [[1.0, 0.0], [0.0, 1.0]]
W_k = [[1.0, 0.0], [0.0, 1.0]]
W_v = [[1.0, 0.0], [0.0, 1.0]]

W_g = [[1.0, 0.5], [0.5, 1.0]]
W_u = [[0.5, 0.2], [0.2, 0.5]]
W_o = [[1.0, 0.0], [0.0, 1.0]]

x_1 = x + Ψ_m(N(x, γ, 1e-5), W_d, W_q, W_k, W_v)
x_2 = x_1 + S(N(x_1, γ, 1e-5), W_g, W_u, W_o)

L = μ((x_2 - y)^2)

g_o = ∇_W_o(L)
W_1 = W_o - (0.001 * Ω_μ(g_o))
