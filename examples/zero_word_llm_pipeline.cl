<< "libcl/math/rms_norm.cl"
<< "libcl/math/causal_transformer.cl"
<< "libcl/math/swiglu_mlp.cl"
<< "libcl/math/bitnet_layer.cl"
<< "libcl/math/mamba2_ssd.cl"

// ════════════════════════════════════════════════════════════════════════════
// BLOCK 1: BASE WEIGHT BINDINGS
// ════════════════════════════════════════════════════════════════════════════
γ   = [1.0, 1.0]
Wq  = [[0.5, 0.1], [0.2, 0.6]]
Wk  = [[0.4, 0.2], [0.1, 0.5]]
Wv  = [[0.7, 0.3], [0.2, 0.8]]
Wo  = [[0.6, 0.4], [0.3, 0.7]]
W1  = [[0.3, 0.5], [0.2, 0.4]]
W2  = [[0.6, 0.1], [0.3, 0.7]]
W3  = [[0.4, 0.2], [0.5, 0.8]]
Wt  = [[1.0, -1.0], [0.0, 1.0]]
A_m = [0.9, 0.8]
B_m = [[0.5, 0.1], [0.2, 0.6]]
C_m = [[0.4, 0.3], [0.1, 0.7]]
Δ_m = [0.1, 0.1]

// ════════════════════════════════════════════════════════════════════════════
// BLOCK 2: PURE MATHEMATICAL FUNCTIONAL COMPOSITION
// ════════════════════════════════════════════════════════════════════════════
F(X[B, D]) = X + A_Φ(N(X, γ), Wq, Wk, Wv, Wo, 0.70710678)
S_mlp(X[B, D]) = F(X) + S(N(F(X), γ), W1, W2, W3)
B_net(X[B, D]) = S_mlp(X) + B(S_mlp(X), Wt, 0.5)
H(X[B, D]) = B_net(X) + M(N(B_net(X), γ), A_m, B_m, C_m, Δ_m)

// ════════════════════════════════════════════════════════════════════════════
// BLOCK 3: TARGET EVALUATION (CANONICAL SOFTMAX PROBABILITIES)
// ════════════════════════════════════════════════════════════════════════════
X = [[1.0, 2.0], [3.0, 4.0]]
ρ(H(X))
