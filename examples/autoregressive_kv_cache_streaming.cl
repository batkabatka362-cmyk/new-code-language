s_0 = "CRON AI"
t = ι(s_0)

E = O(256, 4)
t_0 = t[0]
t_1 = t[1]
x_0 = E[t_0]
x_1 = E[t_1]

W_q = [[0.8, 0.1, 0.0, 0.2], [0.1, 0.7, 0.2, 0.0], [0.0, 0.2, 0.9, 0.1], [0.2, 0.0, 0.1, 0.8]]
W_k = [[0.7, 0.0, 0.1, 0.2], [0.0, 0.8, 0.2, 0.1], [0.1, 0.2, 0.7, 0.0], [0.2, 0.1, 0.0, 0.8]]
W_v = [[0.9, 0.1, 0.1, 0.0], [0.1, 0.9, 0.0, 0.1], [0.1, 0.0, 0.9, 0.1], [0.0, 0.1, 0.1, 0.9]]

q_0 = x_0 @ W_q
k_0 = x_0 @ W_k
v_0 = x_0 @ W_v

K_0 = [k_0]
V_0 = [v_0]

q_1 = x_1 @ W_q
k_1 = x_1 @ W_k
v_1 = x_1 @ W_v

(y_1, K_1, V_1) = Ψ_c(q_1, k_1, v_1, K_0, V_0, 0.5)

W_h = [[1.2, 0.3, 0.1, 0.5], [0.2, 1.4, 0.4, 0.1], [0.1, 0.3, 1.1, 0.2], [0.4, 0.2, 0.1, 1.3]]
z_1 = y_1 @ W_h

z_k = κ_k(z_1, 2)
z_p = κ_p(z_1, 0.95)
t_2 = χ(z_1, 0.7, 0.95, 777)

g_1 = [t_2]
s_1 = δ(g_1)

g_1 >> "autoregressive_output.safetensors:next_token"
y_1 >> "autoregressive_output.safetensors:attn_out"
K_1 >> "autoregressive_output.safetensors:kv_cache"
